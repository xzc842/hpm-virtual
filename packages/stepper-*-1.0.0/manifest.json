{
  "name": "stepper",
  "version": "1.0.0",
  "description": "Generic step/direction stepper motor driver",
  "license": "MIT",
  "toolchain": [
    "sdcc"
  ],
  "config": {
    "step_angle": {
      "type": "int",
      "default": "2"
    }
  },
  "requires": {
    "step": {
      "type": "gpio_out",
      "methods": [
        "init",
        "write"
      ]
    },
    "dir": {
      "type": "gpio_out",
      "methods": [
        "init",
        "write"
      ]
    }
  },
  "provides": {
    "methods": [
      {
        "name": "init",
        "return": "int",
        "params": []
      },
      {
        "name": "set_dir",
        "return": "void",
        "params": [
          {
            "type": "int",
            "name": "dir"
          }
        ]
      },
      {
        "name": "pulse",
        "return": "void",
        "params": [
          {
            "type": "unsigned int",
            "name": "steps"
          }
        ]
      }
    ]
  }
}
