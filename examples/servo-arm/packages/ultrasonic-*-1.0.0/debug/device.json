{
  "name": "ultrasonic",
  "display_name": "超声波测距",
  "version": "1.0.0",
  "model": "device.gltf",
  "script": "virtual.gd",
  "physics": {
    "friction": 0.6,
    "mass": 0.08,
    "rough": true,
    "bounce": 0.05
  },
  "objects": [
    {
      "node": "Body",
      "physics": {
        "friction": 0.6,
        "mass": 0.06,
        "rough": true
      }
    },
    {
      "node": "LeftEye",
      "physics": {
        "friction": 0.35,
        "mass": 0.01,
        "rough": true
      }
    },
    {
      "node": "RightEye",
      "physics": {
        "friction": 0.35,
        "mass": 0.01,
        "rough": true
      }
    },
    {
      "node": "Mount",
      "physics": {
        "friction": 0.75,
        "mass": 0.02,
        "rough": true
      }
    }
  ],
  "config": {
    "effective_distance": {
      "type": "number",
      "title": "有效距离",
      "default": 30.0,
      "min": 1.0,
      "max": 400.0,
      "unit": "cm"
    },
    "max_distance": {
      "type": "number",
      "title": "最大距离",
      "default": 400.0,
      "min": 1.0,
      "max": 400.0,
      "unit": "cm"
    },
    "step_cm": {
      "type": "number",
      "title": "每次触发接近距离",
      "default": 4.0,
      "min": 1.0,
      "max": 100.0,
      "unit": "cm"
    },
    "report_enabled": {
      "type": "bool",
      "title": "启用上报",
      "default": true
    },
    "sensor_mode": {
      "type": "string",
      "title": "工作模式",
      "default": "single"
    },
    "auto_measure": {
      "type": "bool",
      "title": "自动测量场景",
      "default": false
    }
  },
  "channels": {
    "distance": {
      "title": "距离",
      "type": "number",
      "widget": "value",
      "min": 0,
      "max": 400,
      "unit": "cm",
      "readonly": true
    },
    "in_range": {
      "title": "有效范围内",
      "type": "bool",
      "widget": "status",
      "readonly": true
    }
  }
}
