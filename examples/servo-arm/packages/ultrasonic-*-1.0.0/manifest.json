{
  "name": "ultrasonic",
  "version": "1.0.0",
  "description": "Generic GPIO ultrasonic distance sensor",
  "license": "MIT",
  "toolchain": [
    "sdcc"
  ],
  "config": {
    "effective_distance": {
      "type": "int",
      "default": "30",
      "title": "有效距离",
      "unit": "cm"
    },
    "max_distance": {
      "type": "int",
      "default": "400",
      "title": "最大距离",
      "unit": "cm"
    },
    "step_cm": {
      "type": "int",
      "default": "4",
      "title": "每次触发接近距离",
      "unit": "cm"
    },
    "loops_per_cm": {
      "type": "int",
      "default": "60",
      "title": "每厘米循环数"
    }
  },
  "requires": {
    "trig": {
      "type": "gpio_out",
      "methods": [
        "init",
        "write"
      ]
    },
    "echo": {
      "type": "gpio_out",
      "methods": [
        "init",
        "write",
        "read"
      ]
    }
  },
  "provides": {
    "methods": [
      {
        "name": "init",
        "return": "int",
        "params": []
      },
      {
        "name": "trigger",
        "return": "void",
        "params": []
      },
      {
        "name": "read_cm",
        "return": "int",
        "params": []
      }
    ]
  }
}
